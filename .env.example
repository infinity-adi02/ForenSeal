# Copy this file to .env in the repository root, then replace the placeholder secrets.
# Never commit .env; it can contain credentials and local configuration.

# SQLite and evidence paths are relative to the backend/ working directory used by Uvicorn.
DATABASE_URL=sqlite:///./chainofcustody.db
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=52428800

# Use a unique random value for JWT signing. Changing it invalidates existing login tokens.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480

# Created as an administrator at the first API startup if this username does not exist.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password

# Must match the browser's origin. Update this if you change the Vite host or port.
FRONTEND_ORIGIN=http://localhost:5173

# Local Hardhat RPC endpoint; keep this aligned with contracts/hardhat.config.js.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private code required to reveal stored SHA-256 fingerprints; leave unset to keep them hidden.
FINGERPRINT_REVEAL_CODE=replace-with-a-private-admin-code
